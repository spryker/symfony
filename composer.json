{
    "name": "spryker/symfony",
    "type": "library",
    "description": "Symfony module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "symfony-cmf/routing": "^2.3.3 || ^3.0.0",
        "symfony/config": "^6.4.0 || ^7.4.0",
        "symfony/console": "^6.4.0 || ^7.4.0",
        "symfony/debug": "^4.4.9",
        "symfony/error-handler": "^6.4.0 || ^7.4.0",
        "symfony/event-dispatcher": "^6.4.0 || ^7.4.0",
        "symfony/filesystem": "^6.4.0 || ^7.4.0",
        "symfony/finder": "^6.4.0 || ^7.4.0",
        "symfony/form": "^6.4.0 || ^7.4.0",
        "symfony/html-sanitizer": "^6.1 || ^7.4",
        "symfony/http-client": "^6.4.0 || ^7.4.0",
        "symfony/http-foundation": "^6.4.29 || ^7.4.0",
        "symfony/http-kernel": "^6.4.0 || ^7.4.0",
        "symfony/intl": "^6.4.0 || ^7.4.0",
        "symfony/lock": "^6.4.0 || ^7.4.0",
        "symfony/messenger": "^6.4.0 || ^7.4.0",
        "symfony/mime": "^6.4.0 || ^7.4.0",
        "symfony/options-resolver": "^6.4.0 || ^7.4.0",
        "symfony/process": "^6.4.0 || ^7.4.0",
        "symfony/property-access": "^6.4.0 || ^7.4.0",
        "symfony/routing": "^6.4.0 || ^7.4.0",
        "symfony/security-core": "^6.4.0 || ^7.4.0",
        "symfony/security-csrf": "^6.4.0 || ^7.4.0",
        "symfony/security-http": "^6.4.15 || ^7.4.0",
        "symfony/serializer": "^6.4.0 || ^7.4.0",
        "symfony/stopwatch": "^6.4.0 || ^7.4.0",
        "symfony/translation": "^6.4.0 || ^7.4.0",
        "symfony/translation-contracts": "^2.1.2 || ^3.1.0",
        "symfony/twig-bridge": "^6.4.0 || ^7.4.0",
        "symfony/validator": "^6.4.0 || ^7.4.0",
        "symfony/yaml": "^6.4.0 || ^7.4.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/propel": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
